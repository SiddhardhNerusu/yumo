{
  "expo": {
    "name": "Yumo",
    "slug": "yumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yumo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidnerusu.yumo",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sidnerusu.yumo",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bc005fe8-e979-4f32-935d-e21b719c7ab3"
      }
    },
    "owner": "siddu69420",
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Yumo uses the camera to scan barcodes and photograph receipts so you can stock your kitchen in one tap."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yumo lets you attach progress photos to your weigh-ins and pick a receipt photo to scan. Photos stay on your device."
        }
      ],
      "expo-status-bar"
    ]
  }
}
