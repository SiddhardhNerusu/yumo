{
  "expo": {
    "name": "Usual",
    "slug": "usual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "usual",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidnerusu.usual",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.sidnerusu.usual",
